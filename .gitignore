# Configuración personal: API keys y nombre del usuario.
# NUNCA debe subirse al repositorio. Cada persona crea la suya en el primer
# arranque, desde el diálogo de Configuración de la app.
config.json

# Datos de reuniones. Contienen transcripciones y tareas reales.
database.json
database.json.bak

# Archivos generados en cada equipo.
VISTA_MOVIL.html
server_errors.log
__pycache__/
*.pyc

# Caché antigua de la descarga automática, ya retirada del flujo de uso.
/.runtime/

# Los binarios y avisos de tools/ forman parte de la distribución.
# No ignorar *.exe ni tools/.

# Apoyo local: documentación e instrucciones, sin uso durante la ejecución.
/AGENTS.md
/IMPLEMENTACION_AUDIO_LARGO.md

# Plantilla de configuración para distribución; el servidor usa sus propios
# valores predeterminados si aún no existe config.json.
/config.example.json

# Verificaciones y herramientas de desarrollo, sin dependencias de ejecución.
/tests/
